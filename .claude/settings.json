{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/guard-generated.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "conductor-verifier|coordinated-skills:conductor-verifier",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/record-evidence.sh\""
          }
        ]
      }
    ]
  }
}
